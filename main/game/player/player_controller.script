local PlayerStater = require("lib.stater.player_stater")
local Msg = require("lib.msg")
local SpecialType = require("lib.rewards.special.special_type")
local EnhancementType = require("lib.rewards.enhancement.enhancement_type")

local StatesEnum = PlayerStater.StatesEnum

local Urls = {
	Camera = "/camera",
	Weapon = "weapon#controller",
	SessionManager = "/session_manager",
	SoundController = "/sound_controller",
	-- Internal
	SpecialActions = {
		Bomb = "go#bomb"
	}
}
local TriggerStatusEnum = {
	Pressed = hash("pressed"),
	Released = hash("released"),
}

local MAP_SPECIAL_ACTIONS = {
	[SpecialType.Bomb] = Urls.SpecialActions.Bomb
}

local function set_special_action(self, special_action_id)
	local factory_url = MAP_SPECIAL_ACTIONS[special_action_id]
	if not factory_url then return end

	local special_actions_ids = collectionfactory.create(
		factory_url,
		nil,
		nil,
		{ [hash("/root")] = { owner_id = go.get_id() } }
	)

	self.special_action = {
		id = special_actions_ids["/root"]
	}
end

local function enable_special_action(self, special_action_id)
	set_special_action(self, special_action_id)
	msg.post(Urls.SessionManager, Msg.Player.SET_SPECIAL_ACTION, { id = special_action_id })
end

---@class PlayerStore
---@field velocity number
---@field lives number
---@field input vector3

go.property("velocity", 60)
go.property("lives", 3)
go.property("bullet_damage", 2)
go.property("bullet_ricochets", 0)

function init(self)
	---@type PlayerStore
	self.store = {
		velocity = self.velocity,
		lives = self.lives,
		input = vmath.vector3(0),
	}
	self.stater = PlayerStater:new({
		store = self.store
	})
	self.special_action = nil
	self.target_enemies = {}
	self.selected_enemy_id = nil

	-- enable_special_action(self, SpecialType.Bomb)

	msg.post(Urls.SessionManager, Msg.Player.LIFE_INITIALIZED, {
		lives = self.lives,
	})
	msg.post(Urls.Weapon, Msg.Weapon.SET_PROPERTIES, {
		bullet_config = {
			ricochets = self.bullet_ricochets,
		}
	})
	msg.post(Urls.Camera, Msg.Camera.FOLLOW)
end

local function get_target_enemy(self)
	local player_position = go.get_position()

	for i = 1, 3 do
		local enemy = self.target_enemies[i]
		if enemy then
			local result = physics.raycast(player_position, enemy.position, { hash("wall"), hash("obstacle") })
			if not result then
				return enemy
			end
		end
	end

	return nil
end

local function set_selected_enemy(self, enemy)
	local enemy_id = enemy and enemy.id or nil
	if self.selected_enemy_id == enemy_id then return end

	if self.selected_enemy_id then
		msg.post(self.selected_enemy_id, Msg.Enemy.UNSELECT)
	end

	self.selected_enemy_id = enemy_id

	if self.selected_enemy_id then
		msg.post(self.selected_enemy_id, Msg.Enemy.SELECT)
	end
end

local function target_enemies_pipe(self, dt)
	local enemy = get_target_enemy(self)
	set_selected_enemy(self, enemy)

	if not enemy then
		local trigger_status = go.get(Urls.Weapon, "trigger_status")
		if trigger_status == TriggerStatusEnum.Pressed then
			msg.post(Urls.Weapon, Msg.Weapon.STOP_FIRING)
		end

		return
	end

	msg.post(Urls.Weapon, Msg.Weapon.FIRE, {
		direction = enemy.direction,
		damage = self.bullet_damage,
	})
end

local function has_input(store)
	local input = store.input
	return input.x ~= 0 or input.y ~= 0 or input.z ~= 0
end

function fixed_update(self, dt)
	self.stater:update(dt)
	target_enemies_pipe(self, dt)
end

function final(self)
	set_selected_enemy(self, nil)
end

local function on_move(self, message)
	local direction = message.direction
	self.store.input = direction
	self.stater:set_direction(direction)

	if self.stater:is(StatesEnum.Move) then
		return
	end

	self.stater:apply_transition(StatesEnum.Move, {
		direction = direction,
	})
	msg.post(Urls.SoundController, Msg.Sound.PLAY_SFX_SOUND, { id = hash("steps"), random_pitch = true })
end

local function on_stop_move(self, message)
	self.store.input = vmath.vector3(0)

	if self.stater:is(StatesEnum.Move) then
		self.stater:apply_transition(StatesEnum.Idle, {})
	end

	msg.post(Urls.SoundController, Msg.Sound.STOP_SFX_SOUND, { id = hash("steps") })
end

local function on_apply_damage(self, message)
	self.stater:apply_transition(StatesEnum.Hurt, {
		damage = message.damage,
		direction = message.direction,
		force = message.force,
	})
	self.store.lives = self.store.lives - 1

	msg.post(Urls.Camera, Msg.Camera.SHAKE, {
		shake_duration = 0.2,
		shake_magnitude = 2,
	})
	msg.post(Urls.SessionManager, Msg.Player.LIFE_CHANGED, {
		current_lives = self.store.lives,
		total_lives = self.lives,
	})
end

local function on_target_enemies(self, message)
	self.target_enemies = message.enemies
end

local function on_set_position(self, message)
	go.set_position(message.position)
end

local function on_apply_upgrade(self, message)
	local selected = message or {}
	if selected.id == EnhancementType.Ricochet then
		self.bullet_ricochets = self.bullet_ricochets + (selected.value or 1)
		msg.post(Urls.Weapon, Msg.Weapon.SET_PROPERTIES, {
			bullet_config = {
				ricochets = self.bullet_ricochets,
			}
		})
	elseif selected.id == "bullet_damage" then
		self.bullet_damage = self.bullet_damage + (selected.stat_1 and selected.stat_1.value or selected.value or 0)
	end
end

local function on_set_special_action(self, message)
	set_special_action(self, message.id)
end

local function on_run_special_action(self, message)
	if not self.special_action then return end

	msg.post(self.special_action.id, Msg.SpecialAction.PREPARE)
end

local function on_move_special_action(self, message)
	if not self.special_action then return end

	msg.post(self.special_action.id, Msg.SpecialAction.AIM, message)
end

local function on_release_special_action(self, message)
	if not self.special_action then return end

	msg.post(self.special_action.id, Msg.SpecialAction.LAUNCHED)
	msg.post(Urls.SessionManager, Msg.Player.SPECIAL_ACTION_USED)
end

local function on_cancel_special_action(self, message)
	if not self.special_action then return end
	msg.post(self.special_action.id, Msg.SpecialAction.CANCELED)
end

local function on_fire_weapon(self, message)
	if has_input(self.store) then return end

	self.stater:set_facing(message.direction.x)
	sprite.play_flipbook(self.stater.urls.VisualSprite, "shot", function()
		sprite.play_flipbook(self.stater.urls.VisualSprite, "idle")
	end)
end

function on_message(self, message_id, message, sender)
	if message_id == Msg.Player.MOVE then
		on_move(self, message)
	elseif message_id == Msg.Player.STOP_MOVE then
		on_stop_move(self, message)
	elseif message_id == Msg.APPLY_DAMAGE then
		on_apply_damage(self, message)
	elseif message_id == Msg.Player.SET_TARGET_ENEMIES then
		on_target_enemies(self, message)
	elseif message_id == Msg.Player.SET_POSITION then
		on_set_position(self, message)
	elseif message_id == Msg.Player.APPLY_UPGRADE then
		on_apply_upgrade(self, message)
	elseif message_id == Msg.Player.SET_SPECIAL_ACTION then
		on_set_special_action(self, message)
	elseif message_id == Msg.Player.RUN_SPECIAL_ACTION then
		on_run_special_action(self, message)
	elseif message_id == Msg.Player.MOVE_SPECIAL_ACTION then
		on_move_special_action(self, message)
	elseif message_id == Msg.Player.RELEASE_SPECIAL_ACTION then
		on_release_special_action(self, message)
	elseif message_id == Msg.Player.CANCEL_SPECIAL_ACTION then
		on_cancel_special_action(self, message)
	elseif message_id == Msg.Weapon.FIRED then
		on_fire_weapon(self, message)
	end
end

function on_reload(self)
end
