  type: CONSTANT_TYPE_USER
  value {
    x: 0.5
    y: 0.5
  }
}
fragment_constants {
  name: "u_params"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 0.025
    z: 0.2
  }
}
fragment_constants {
  name: "u_ring"
  type: CONSTANT_TYPE_USER
  value {
    x: 0.5
  }
}
fragment_constants {
  name: "u_color"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 0.35
    z: 0.1
    w: 1.0
  }
}
samplers {
  name: "texture0"
  wrap_u: WRAP_MODE_REPEAT
  wrap_v: WRAP_MODE_REPEAT
  filter_min: FILTER_MODE_MIN_LINEAR_MIPMAP_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
