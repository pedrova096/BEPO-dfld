local LevelRuntime = require("modules.level.runtime")
local LevelEvents = require("modules.level.events")
local EnemyPool = require("utils.pooler.enemy_pool")
local RandomPositionGenerator = require("utils.position_generator.random_position_generator")
local SetPositionGenerator = require("utils.position_generator.set_position_generator")
local TilesInfo = require("utils.tiles_info")
local VMath = require("utils.vmath")
local Msg = require("lib.msg")

local Urls = {
	FactoryEnemy01 = "/level_manager#cfactory_enemy_01",
	FactoryEnemy02 = "/level_manager#cfactory_enemy_02",
	GameController = "/controller",
	UIController = "/ui",
	SessionManager = "/session_manager",
	Camera = "/camera",
	Tilemap01Factory = "/level_manager#tilemap_01_factory",
	Tilemap02Factory = "/level_manager#tilemap_02_factory",
	PlayerController = "/player/root#controller",
	UpgraderFactory = "/level_manager#upgrader_factory",
	ConnectionFactory = "/level_manager#door_factory"
}

local FACTORIES_MAP = {
	enemy_01 = Urls.FactoryEnemy01,
	enemy_02 = Urls.FactoryEnemy02,
}

local TILEMAP_FACTORY_MAP = {
	[hash("tilemap_01")] = Urls.Tilemap01Factory,
	[hash("tilemap_02")] = Urls.Tilemap02Factory,
}

local DoorsEnum = {
	Normal = 10,
	Opened = 11,
	Random = 12,
	Hard = 13,
	Boss = 14,
}

local function delete_id(id, recursive)
	if not id then return end
	go.delete(id, recursive or false)
end

local function clear_stage_objects(self)
	if self.stage_info and self.stage_info.connections then
		for _, connection in ipairs(self.stage_info.connections) do
			delete_id(connection.object_id)
		end
	end

	delete_id(self.upgrader_id)
	delete_id(self.current_tilemap and self.current_tilemap.id, true)

	self.upgrader_id = nil
	self.current_tilemap = nil
	self.stage_info = nil
end

local function spawn_connections(self, connections)
	local tiles_lg_url = msg.url(nil, self.current_tilemap.tiles_lg, "tileset")
	local bounds = TilesInfo.get_bounds(tiles_lg_url)

	local offset = go.get_position(self.current_tilemap.id)

	self.stage_info.connections = TilesInfo.get_doors_positions({
		offset = offset,
		bounds = bounds,
		doors_amount = #connections,
	})

	for index, connection in ipairs(self.stage_info.connections) do
		tilemap.set_tile(tiles_lg_url, "walls", connection.column_index, connection.row_index, DoorsEnum.Normal)

		local connection_id = factory.create(Urls.ConnectionFactory, connection.position, nil, {
			next_stage = connections[index].next_stage,
			reward = connections[index].reward,
		})
		connection.object_id = connection_id
	end
end

local function is_current_stage_last(self)
	local stage = self.runtime:get_current_stage()
	return not stage or not stage.connections or #stage.connections == 0
end

local function on_stage_complete(self)
	if is_current_stage_last(self) then
		msg.post(Urls.UIController, Msg.HudUI.SHOW_COMPLETED_LEVEL_MODAL)
		return
	end

	if not self.stage_info.upgrader_position then return end

	self.upgrader_id = factory.create(Urls.UpgraderFactory, self.stage_info.upgrader_position, nil, {
		reward = self.current_stage_reward
	})

	msg.post(Urls.GameController, Msg.Stager.STAGE_COMPLETED, {
		upgrader_position = self.stage_info.upgrader_position
	})
end

local function drain_runtime_events(self)
	local events = self.runtime:drain_events()

	for _, event in ipairs(events) do
		local payload = event.payload or {}
		if event.name == LevelEvents.SPAWN_ENEMY_REQUESTED then
			self.enemies_pool:acquire_or_extend({
				wave_id = payload.wave_id,
				type = payload.enemy.id,
			})
		elseif event.name == LevelEvents.WAVE_STARTED then
			-- msg.post("#level_manager", Msg.Wave.WAVE_STARTED, { index = payload.index })
		elseif event.name == LevelEvents.STAGE_COMPLETED then
			on_stage_complete(self)
		elseif event.name == LevelEvents.ENEMY_RELEASE_REQUESTED then
			self.enemies_pool:request_release(payload.enemy_id)
		elseif event.name == LevelEvents.ENEMY_RELEASE_CONFIRMED then
			self.enemies_pool:confirm_release(payload.enemy_id)
		end
	end
end

local function parse_stage_info(self)
	local tiles_sm_url = msg.url(nil, self.current_tilemap.tiles_sm, "tileset")
	local tiles_lg_url = msg.url(nil, self.current_tilemap.tiles_lg, "tileset")

	tilemap.set_visible(tiles_sm_url, "landmarks", false)

	local stage_size = TilesInfo.get_lg_size(tiles_lg_url)
	return TilesInfo.get_landmark_info({
		offset = go.get_position(self.current_tilemap.id),
		landmarks_tiles = tilemap.get_tiles(tiles_sm_url, "landmarks"),
		bounds = TilesInfo.get_bounds(tiles_sm_url),
	}), stage_size
end

go.property("debug", false)

function init(self)
	self.runtime = LevelRuntime:new({
		max_overlap = 2,
		debug = self.debug,
	})
	self.enemies_pool = EnemyPool.new({
		factory_map = FACTORIES_MAP,
		position_generator = RandomPositionGenerator:new(200, -200),
	})

	self.current_tilemap = nil
	self.stage_info = nil
	self.upgrader_id = nil
end

local function target_enemies_pipe(self, dt)
	local active_enemies = self.enemies_pool:get_actives()
	local player_position = VMath.z_one(go.get_position(Urls.PlayerController))
	local enemy_positions = {}
	for _, enemy in ipairs(active_enemies) do
		local position = VMath.z_one(go.get_position(enemy.id)) + vmath.vector3(0, 12, 0)
		local delta = position - player_position
		table.insert(enemy_positions, {
			id = enemy.id,
			position = position,
			delta = delta,
			distance = vmath.length(delta),
			direction = vmath.normalize(delta)
		})
	end

	table.sort(enemy_positions, function(a, b)
		return a.distance < b.distance
	end)

	msg.post(Urls.PlayerController, Msg.Player.SET_TARGET_ENEMIES, {
		enemies = enemy_positions,
	})
end

function update(self, dt)
	self.runtime:update(dt)
	drain_runtime_events(self)
	target_enemies_pipe(self, dt)
end

local function on_enemy_killed(self, message)
	self.runtime:enemy_killed({
		enemy_id = message.enemy_id,
		position = message.position,
		wave_id = message.wave_id,
	})
	msg.post(Urls.SessionManager, Msg.Player.ADD_KILL_COUNT, { amount = 1, })
	drain_runtime_events(self)
end

local function on_confirm_enemy_despawn(self, message)
	self.runtime:enemy_despawned({
		enemy_id = message.enemy_id,
	})
	drain_runtime_events(self)
end

local function on_load_stage(self, message)
	self.enemies_pool:reset()
	clear_stage_objects(self)

	local stage_data = message.stage.data
	local next_connections = message.stage.connections
	self.current_stage_id = message.stage.id

	-- Create the tilemap
	local tilemap_factory = TILEMAP_FACTORY_MAP[stage_data.tilemap_id]
	if not tilemap_factory then
		error(("Stage factory not found for tilemap_id %s"):format(tostring(stage_data.tilemap_id)))
	end

	local ids = collectionfactory.create(tilemap_factory)
	self.current_tilemap = {
		id = ids["/root"],
		tiles_sm = ids["/tiles_sm"],
		tiles_lg = ids["/tiles_lg"],
	}

	local stage_info, stage_size = parse_stage_info(self)
	self.stage_info = {
		connections = {},
		upgrader_position = stage_info.upgrader_position
	}
	if next_connections then
		spawn_connections(self, next_connections)
	end

	self.enemies_pool:set_position_generator(SetPositionGenerator:new(stage_info.spawn_positions))

	self.current_stage_reward = stage_data.reward
	self.runtime:load_stage({
		stage = message.stage,
	})
	drain_runtime_events(self)

	msg.post(Urls.GameController, Msg.Stager.STAGE_LOADED, {
		stage_id = self.current_stage_id,
		stage = message.stage,
		transition = message.transition or false,
		duration = message.duration,
		player_position = stage_info.player_position
	})
	msg.post(Urls.Camera, Msg.Camera.SET_BOUNDS, stage_size)
end

local function on_start_stage(self, _message)
	self.runtime:start_stage()
	drain_runtime_events(self)
end

local function on_enable_connections(self, _)
	if self.upgrader_id then
		local upgrader_id = self.upgrader_id
		self.upgrader_id = nil
		msg.post(upgrader_id, Msg.REMOVE_ELEMENT)
	end

	if not self.current_tilemap or not self.stage_info or not self.stage_info.connections then return end

	local tiles_lg_url = msg.url(nil, self.current_tilemap.tiles_lg, "tileset")
	for _, connection in ipairs(self.stage_info.connections) do
		msg.post(connection.object_id, Msg.HIDE_ELEMENT)
		tilemap.set_tile(tiles_lg_url, "walls", connection.column_index, connection.row_index, DoorsEnum.Opened)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == Msg.Stager.LOAD_STAGE then
		on_load_stage(self, message)
	elseif message_id == Msg.Stager.START_STAGE then
		on_start_stage(self, message)
	elseif message_id == Msg.Enemy.ENEMY_KILLED then
		on_enemy_killed(self, message)
	elseif message_id == Msg.Stager.ENABLE_CONNECTIONS then
		on_enable_connections(self, message)
	elseif message_id == Msg.Enemy.CONFIRM_ENEMY_DESPAWN then
		on_confirm_enemy_despawn(self, message)
	end
end
