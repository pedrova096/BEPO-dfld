local Colors = require("lib.colors")
local Msg = require("lib.msg")
local Math = require("utils.math")
local VMath = require("utils.vmath")
local Entity = require("utils.entity")
local Ricochet = require("utils.weapon.ricochet")

go.property("id", 0)
go.property("target", hash("none"))
go.property("owner_id", hash("none"))
go.property("theme", 1) -- 1: normal, 2: enemy

local Urls = {
	Sprite = "#sprite",
	Zone = "#zone",
	Body = "#body",
}

local function set_normal_theme_colors(self)
	if self.theme == 1 then
		local color3 = vmath.vector4(unpack(Colors["#ffe478"])) * 0.5
		go.set(Urls.Sprite, "target_color_1", vmath.vector4(unpack(Colors["#ffffeb"])))
		go.set(Urls.Sprite, "target_color_2", vmath.vector4(unpack(Colors["#f2a65e"])))
		go.set(Urls.Sprite, "target_color_3", color3)
	elseif self.theme == 2 then
		local color3 = vmath.vector4(unpack(Colors["#b7ee7b"])) * 0.5
		go.set(Urls.Sprite, "target_color_1", vmath.vector4(unpack(Colors["#ebffeb"])))
		go.set(Urls.Sprite, "target_color_2", vmath.vector4(unpack(Colors["#6dc170"])))
		go.set(Urls.Sprite, "target_color_3", color3)
	end
end

local function mix_theme_colors()
	local target_color_1 = go.get(Urls.Sprite, "target_color_1")
	local target_color_2 = go.get(Urls.Sprite, "target_color_2")
	local target_color_3 = go.get(Urls.Sprite, "target_color_3")

	go.set(Urls.Sprite, "target_color_1", target_color_2)
	go.set(Urls.Sprite, "target_color_2", target_color_1)
	go.set(Urls.Sprite, "target_color_3", vmath.vector4(
		1 - target_color_3.z,
		target_color_3.y,
		1 - target_color_3.x,
		target_color_3.w
	))
end

local function stop_color_swap_timer(self)
	if self.color_swap_timer then
		timer.cancel(self.color_swap_timer)
		self.color_swap_timer = nil
	end
end

local function disabled_bullet()
	Entity.disable_body(Urls.Zone)
	Entity.disable_body(Urls.Body)
	Entity.hide_sprite(Urls.Sprite)
end

local function enabled_bullet()
	sprite.play_flipbook(Urls.Sprite, "default")
	Entity.enable_body(Urls.Zone)
	Entity.enable_body(Urls.Body)
	Entity.show_sprite(Urls.Sprite)
end

local function finish_bullet(self)
	stop_color_swap_timer(self)
	set_normal_theme_colors(self)
	go.set_scale(vmath.vector3(1))
	go.set(Urls.Body, "linear_velocity", vmath.vector3(0))
	sprite.play_flipbook(Urls.Sprite, "disappear", function()
		msg.post(self.owner_id, Msg.Bullet.FINISHED, { id = self.id })
		disabled_bullet()
		-- self.config = nil
	end)
end

local function set_bullet_direction(self, direction)
	self.config.direction = VMath.normalize_or_zero(direction)
	local velocity = self.config.direction * self.config.speed
	local heading_angle = Math.heading_angle(velocity) + math.pi / 2
	go.set_rotation(vmath.quat_rotation_z(heading_angle))
	go.set(Urls.Body, "linear_velocity", velocity)
end

local function try_ricochet(self, hit_id)
	local direction = self.ricochet:try_ricochet({
		position = go.get_position(),
		target_group = self.target,
		hit_id = hit_id,
	})
	if not direction then
		return false
	end

	set_bullet_direction(self, direction)
	return true
end

function init(self)
	physics.set_maskbit(Urls.Zone, self.target, true)
	set_normal_theme_colors(self)
	self.ricochet = Ricochet:new()

	disabled_bullet()
end

function update(self, dt)
	self.ricochet:update(dt)
end

local function on_bullet_fired(self, message)
	enabled_bullet()

	self.config = message
	self.ricochet:reset({
		remaining = self.config.ricochets,
		config = {
			ray_count = self.config.ricochet_ray_count,
			ray_range = self.config.ricochet_ray_range,
			ray_start_offset = self.config.ricochet_ray_start_offset,
			check_obstacles = self.config.ricochet_check_obstacles,
		}
	})

	local velocity = self.config.direction * self.config.speed
	local position = VMath.z_extends(self.config.position, 3)
	local heading_angle = Math.heading_angle(velocity) + math.pi / 2
	go.set_position(position)
	go.set_rotation(vmath.quat_rotation_z(heading_angle))
	go.set(Urls.Body, "linear_velocity", velocity)

	if self.config.is_critic then
		go.set_scale(vmath.vector3(1.5, 1.5, 1))
		stop_color_swap_timer(self)
		self.color_swap_timer = timer.delay(0.05, true, mix_theme_colors)
	end
end

local function on_trigger_response(self, message)
	if not message.enter then return end

	if message.other_group == self.target then
		msg.post(message.other_id, Msg.APPLY_DAMAGE, {
			damage = self.config.damage,
			direction = self.config.direction,
			force = self.config.force,
		})

		if try_ricochet(self, message.other_id) then
			return
		end
	end

	finish_bullet(self)
end

function on_message(self, message_id, message, sender)
	if message_id == Msg.Bullet.FIRED then
		on_bullet_fired(self, message)
	elseif message_id == Msg.TRIGGER_OCCURRED then
		on_trigger_response(self, message)
	end
end
