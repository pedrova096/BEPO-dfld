local Msg = require("lib.msg")
local Table = require("utils.table")
local Level = require("modules.level.level")
local Logger = require("modules.logger")
local LevelAdapter = require("lib.levels_adapter")
local RewardTypes = require("lib.rewards.reward_types")
local CogsData = require("lib.rewards.status.cogs_data")

local Urls = {
	Factories = {
		Cog = "/factories#cog_cfactory",
	},
	-- External
	UIController = "/ui",
	Player = "/player/root",
	LevelManager = "/level_manager",
	SoundController = "/sound_controller",
}

local StatesEnum = {
	Active = 1,
	Paused = 2,
	AutoCollect = 3,
}

local TransitionStates = {
	Idle = 1,
	WipingIn = 2,
	LoadingStage = 3,
	PositioningPlayer = 4,
	WipingOut = 5,
}

local PLAYER_STAGE_ENTRY_POSITION = vmath.vector3(0, 0, 1)
local FLOW_TRACE_ENABLED = true
local logger = Logger.new_debugger(FLOW_TRACE_ENABLED, "FLOW")

local function spawn_cog(self, options)
	local properties = options and { value = options.value, variant = options.variant } or nil
	local position = options and options.position or vmath.vector3()
	local new_collection = collectionfactory.create(Urls.Factories.Cog, position, nil, { [hash("/root")] = properties })
	return new_collection["/root"]
end

local function set_transition_state(self, state)
	self.transition_state = state
end

function init(self)
	self.level = Level:new()

	self.state = StatesEnum.Active
	self.loading_stage = false
	self.pending_stage_load = nil
	set_transition_state(self, TransitionStates.Idle)
end

local function on_open_upgrader(self, message)
	self.state = StatesEnum.Paused
	msg.post(Urls.UIController, Msg.ControlsUI.DISABLE_MOVE)
	msg.post(Urls.Player, Msg.Player.STOP_MOVE)
	msg.post(Urls.UIController, Msg.ControlsUI.BLOCK_CONTROLS)
	msg.post(Urls.UIController, Msg.HudUI.SHOW_SHOP_MODAL, message)
end

local function on_process_player_upgrade(self, message)
	self.state = StatesEnum.Active

	msg.post(Urls.UIController, Msg.ControlsUI.ENABLE_MOVE)
	msg.post(Urls.LevelManager, Msg.Stager.ENABLE_CONNECTIONS)

	local reward = self.level:get_current_reward()

	if reward == RewardTypes.StatusSelector or reward == RewardTypes.EnhancementUpgrade then
		msg.post(Urls.Player, Msg.Player.APPLY_UPGRADE, message.selected)
	elseif reward == RewardTypes.SpecialAction then
		msg.post(Urls.UIController, Msg.ControlsUI.ENABLE_BUTTON_ACTION, {
			movable = true
		})
		msg.post(Urls.Player, Msg.Player.SET_SPECIAL_ACTION, message.selected)
	end
end

local function request_stage_load(self, message)
	logger:debug("stage_load_requested", {
		stage_id = message.stage.id,
		transition = message.transition or false,
	})
	msg.post(Urls.LevelManager, Msg.Stager.LOAD_STAGE, {
		stage = message.stage,
		transition = message.transition or false,
		duration = message.duration,
	})
end

local function on_load_level_stage(self, message)
	if self.loading_stage then return end

	self.loading_stage = true
	if message.transition then
		self.pending_stage_load = message
		set_transition_state(self, TransitionStates.WipingIn)
		logger:debug("wipe_show_requested", {
			stage_id = message.stage.id,
			duration = message.duration or 0.5,
		})
		msg.post(Urls.UIController, Msg.ControlsUI.DISABLE_MOVE)
		msg.post(Urls.Player, Msg.Player.STOP_MOVE)
		msg.post(Urls.UIController, Msg.HudUI.SHOW_WIPE, {
			duration = message.duration or 0.5,
		})
		return
	end

	set_transition_state(self, TransitionStates.LoadingStage)
	request_stage_load(self, message)
end

local function on_start_run(self, message)
	local stage_payload = self.level:start_run({
		level = LevelAdapter.get_level(message.level_id),
	})

	on_load_level_stage(self, {
		stage = stage_payload,
		transition = false,
	})
end

local function on_connection_entered(self, message)
	local stage_payload = self.level:choose_connection(message.next_stage, {
		transition = true,
	})
	if not stage_payload then return end

	on_load_level_stage(self, {
		stage = stage_payload,
		transition = true,
	})
end

local function on_stage_loaded(self, message)
	self.level:load_stage({
		stage = message.stage,
		transition = message.transition or false,
		duration = message.duration,
	})

	logger:debug("stage_loaded", {
		stage_id = message.stage_id,
		transition = message.transition or false,
	})

	local player_position = message.player_position or PLAYER_STAGE_ENTRY_POSITION
	set_transition_state(self, TransitionStates.PositioningPlayer)
	msg.post(Urls.Player, Msg.Player.STOP_MOVE)
	msg.post(Urls.Player, Msg.Player.SET_POSITION, {
		position = player_position,
	})
	logger:debug("player_positioned", {
		stage_id = message.stage_id,
		position = player_position,
	})

	if not message.transition then
		self.level:start_stage()
		msg.post(Urls.LevelManager, Msg.Stager.START_STAGE)
		self.loading_stage = false
		self.pending_stage_load = nil
		set_transition_state(self, TransitionStates.Idle)
		return
	end

	set_transition_state(self, TransitionStates.WipingOut)
	logger:debug("wipe_hide_requested", {
		stage_id = message.stage_id,
		duration = message.duration or 0.5,
	})
	msg.post(Urls.UIController, Msg.HudUI.HIDE_WIPE, {
		duration = message.duration or 0.5,
	})
end

local MIN_COG_AMOUNT = 2
local MAX_COG_AMOUNT = 4
local function on_stage_completed(self, message)
	local cogs_amount = math.random(MIN_COG_AMOUNT, MAX_COG_AMOUNT)
	local cog_types = Table.pick_random(CogsData.List, cogs_amount)
	for _, cog in ipairs(cog_types) do
		spawn_cog(self, {
			position = message.upgrader_position,
			variant = cog.id,
			value = cog.value,
		})
	end
end

local function on_wipe_shown(self, _message)
	if self.transition_state ~= TransitionStates.WipingIn or not self.pending_stage_load then
		return
	end

	set_transition_state(self, TransitionStates.LoadingStage)
	request_stage_load(self, self.pending_stage_load)
end

local function on_wipe_hidden(self, _message)
	if self.transition_state ~= TransitionStates.WipingOut then
		return
	end

	self.level:start_stage()
	msg.post(Urls.LevelManager, Msg.Stager.START_STAGE)
	msg.post(Urls.UIController, Msg.ControlsUI.ENABLE_MOVE)
	self.loading_stage = false
	self.pending_stage_load = nil
	set_transition_state(self, TransitionStates.Idle)
end

local function on_cog_picked(self, message)
	msg.post(Urls.UIController, Msg.HudUI.SHOW_TOAST, {
		icon = CogsData.Types[message.variant].icon,
		text = CogsData.Types[message.variant].text .. " (" .. message.value .. ")",
		duration = 1 -- duration its optional
	})
end

function on_message(self, message_id, message, sender)
	if message_id == Msg.Game.OPEN_UPGRADER then
		on_open_upgrader(self, message)
	elseif message_id == Msg.Game.START_RUN then
		on_start_run(self, message)
	elseif message_id == Msg.Stager.CONNECTION_ENTERED then
		on_connection_entered(self, message)
	elseif message_id == Msg.Game.LOAD_LEVEL_STAGE then
		on_load_level_stage(self, message)
	elseif message_id == Msg.Game.PROCESS_PLAYER_UPGRADE then
		on_process_player_upgrade(self, message)
	elseif message_id == Msg.Game.COG_PICKED then
		on_cog_picked(self, message)
	elseif message_id == Msg.Stager.STAGE_LOADED then
		on_stage_loaded(self, message)
	elseif message_id == Msg.Stager.STAGE_COMPLETED then
		on_stage_completed(self, message)
	elseif message_id == Msg.HudUI.WIPE_SHOWN then
		on_wipe_shown(self, message)
	elseif message_id == Msg.HudUI.WIPE_HIDDEN then
		on_wipe_hidden(self, message)
	end
end
