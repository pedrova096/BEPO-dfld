local LimitStateTimer = require("lib.stater.limit_state_timer")
local UtilsGUI = require("utils.utils_gui")
local Inputs = require("lib.inputs")
local Msg = require("lib.msg")
local SuperActionOptions = require("lib.super_actions")

local ActionIds = {
	TouchMulti = hash("touch_multi"),
	Touch = hash("touch"),
}

local Urls = {
	GameController = "/controller",
	PlayerController = "/player/root#controller",
	MoveZone = "move_zone",
	MovePad = "move_pad",
	MoveController = "move_controller",
	Button = "button",
	LifeNode = "life_node",
	Footer = "footer",
	Wipe = "wipe",
	ShopModal = "shop_modal",
	UpgradeContainer = "upgrade_container",
}

local UpgradeTypes = {
	SuperAction = hash("super_action"),
}

local ActionStates = {
	Idle = hash("idle"),
	Pressed = hash("pressed"),
}

function init(self)
	msg.post(".", "acquire_input_focus")

	local move_pad_node = gui.get_node(Urls.MovePad)
	local move_controller_node = gui.get_node(Urls.MoveController)
	local button_node = gui.get_node(Urls.Button)

	self.original_move_pad_position = gui.get_position(move_pad_node)
	self.original_move_controller_position = gui.get_position(move_controller_node)

	self.move_zone_action = {
		enabled = true,
		touch_id = nil,
		state = ActionStates.Idle,
		position = vmath.vector3(0),
	}
	self.button_action = {
		enabled = false,
		touch_id = nil,
		state = ActionStates.Idle,
		position = vmath.vector3(0),
		original_position = gui.get_position(button_node),
		time = 0,
		-- auto_timer = nil,
	}

	self.upgrade_container_origin = gui.get_position(gui.get_node(Urls.UpgradeContainer))

	self.life_nodes = {}
	self.has_super_action = false
	self.upgrade_options_active = false
	self.debug = {
		enabled = true,
		keyboard_direction = vmath.vector3()
	};

	-- button is hidden until the player gets a super_action
	gui.set_enabled(button_node, false)
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

local function wipe_view_pipe(self, dt)
	if not self.wipe_timer then return end

	self.wipe_timer:update(dt)
	if self.wipe_timer:is_expired() then
		self.wipe_timer = nil
		return
	end

	local progress = self.wipe_timer:progress()

	local wipe_node = gui.get_node(Urls.Wipe)

	gui.set(wipe_node, "progress.x", progress + 0.1)
end

function update_button_time_pipe(self, dt)
	if not self.button_action.enabled then return end

	self.button_action.time = self.button_action.time + dt
end

function update(self, dt)
	wipe_view_pipe(self, dt)
	update_button_time_pipe(self, dt)
end

local LIFE_NODE_SPACING = 32
local function on_set_life_count(self, message)
	local original_life_node = gui.get_node(Urls.LifeNode)
	local original_life_node_position = gui.get_position(original_life_node)
	local life_count = message.lives

	for i = 1, life_count do
		local life_node_id = "life_node_" .. i
		local life_node = gui.clone(original_life_node)
		local life_node_position = original_life_node_position + vmath.vector3((i - 1) * LIFE_NODE_SPACING, 0, 0)
		gui.set_position(life_node, life_node_position)
		gui.set_visible(life_node, true)
		gui.set_id(life_node, life_node_id)

		table.insert(self.life_nodes, { id = life_node_id, active = true })
	end
end

local function shake_life_node(self, life_node)
	local life_node_position = gui.get_position(life_node)
	gui.animate(life_node, "position.x", life_node_position.x + 2, gui.EASING_INBOUNCE, 0.125, 0, function()
		gui.animate(life_node, "position.x", life_node_position.x, gui.EASING_OUTBOUNCE, 0.125, 0)
	end)
end

local function on_player_life_changed(self, message)
	local current_lives = message.current_lives + 1

	for index, life in ipairs(self.life_nodes) do
		local life_node = gui.get_node(life.id)

		if index < current_lives then
			life.active = true
			gui.play_flipbook(life_node, "life")
		else
			-- was active
			if life.active then
				shake_life_node(self, life_node)
			end
			life.active = false
			gui.play_flipbook(life_node, "life_empty")
		end
	end
end

local function on_show_wipe(self, message)
	local wipe_node = gui.get_node(Urls.Wipe)
	gui.set_visible(wipe_node, true)
	self.wipe_timer = LimitStateTimer:new({
		duration = message.duration or 0.5,
	})
end

local function on_toggle_move(self, enabled)
	self.move_zone_action.enabled = enabled
end

local function on_toggle_button_action(self, enabled)
	self.button_action.enabled = enabled
end

local UPGRADE_NODES = { "upgrade_a", "upgrade_b", "upgrade_c" }
local SLIDE_OFFSET_X = 120
local SLIDE_DURATION = 0.35
local SLIDE_STAGGER = 0.12
local MODAL_VISIBLE_ALPHA = 0.75
local MODAL_DISMISS_FADE_DURATION = 0.22
local UPGRADE_DISMISS_OFFSET_Y = -84
local UPGRADE_DISMISS_DURATION = 0.22
local function upgrade_chosen(self, upgrade)
	local shop_modal_node = gui.get_node(Urls.ShopModal)
	local upgrade_container_node = gui.get_node(Urls.UpgradeContainer)
	local current_upgrade_container_position = gui.get_position(upgrade_container_node)

	gui.cancel_animations(shop_modal_node, "color.w")
	gui.cancel_animations(upgrade_container_node, "position.y")

	gui.animate(shop_modal_node, "color.w", 0, gui.EASING_INOUTQUAD, MODAL_DISMISS_FADE_DURATION)
	gui.animate(upgrade_container_node, "position.y", current_upgrade_container_position.y + UPGRADE_DISMISS_OFFSET_Y,
		gui.EASING_INQUAD, UPGRADE_DISMISS_DURATION, 0, function()
			gui.set_enabled(shop_modal_node, false)
			gui.set_alpha(shop_modal_node, MODAL_VISIBLE_ALPHA)
			for _, node_id in ipairs(UPGRADE_NODES) do
				local node = gui.get_node(node_id)
				gui.set_enabled(node, false)
			end
		end)

	self.upgrade_options_active = false
	self.has_super_action = true

	-- re-enable player controls
	self.move_zone_action.enabled = true
	self.button_action.enabled = true

	-- show the button
	local button_node = gui.get_node(Urls.Button)
	gui.set_enabled(button_node, true)

	msg.post(Urls.GameController, Msg.Game.UPGRADE_CHOSEN, { upgrade = upgrade })
	if upgrade.type == UpgradeTypes.SuperAction then
		msg.post(Urls.PlayerController, Msg.Player.SET_SUPER_ACTION, { id = upgrade.id })
	end
end

local function show_super_action_selection(self)
	local options = SuperActionOptions
	local upgrade_container_node = gui.get_node(Urls.UpgradeContainer)

	gui.set_position(upgrade_container_node, self.upgrade_container_origin)

	if #options > #UPGRADE_NODES then
		print("[ui_controller] not enough upgrade nodes for options!")
		return
	end

	for i, option in ipairs(options) do
		local node = gui.get_node(UPGRADE_NODES[i])
		local title_node = gui.get_node(option.title_node)
		local desc_node = gui.get_node(option.desc_node)

		gui.set_enabled(node, true)
		gui.set_text(title_node, option.title)
		gui.set_text(desc_node, option.description)

		-- set up slide start state
		local orig_pos = gui.get_position(node)
		gui.set_position(node, vmath.vector3(orig_pos.x + SLIDE_OFFSET_X, orig_pos.y, orig_pos.z))
		gui.set_alpha(node, 0)

		local delay = (i - 1) * SLIDE_STAGGER
		local is_last = (i == #options)

		gui.animate(node, "position.x", orig_pos.x, gui.EASING_OUTQUART, SLIDE_DURATION, delay)
		gui.animate(node, "color.w", 1, gui.EASING_LINEAR, SLIDE_DURATION, delay, function()
			if is_last then
				self.upgrade_options_active = true
			end
		end)
	end
end

local function on_show_shop_modal(self, message)
	local shop_modal_node = gui.get_node(Urls.ShopModal)
	gui.set_alpha(shop_modal_node, MODAL_VISIBLE_ALPHA)
	gui.set_enabled(shop_modal_node, true)

	local upgrade_type = message and message.upgrade_type
	if upgrade_type == hash("super_action") then
		show_super_action_selection(self)
	else
		print("[ui_controller] upgrade_type not implemented: " .. tostring(upgrade_type))
	end
end

function on_message(self, message_id, message, sender)
	if message_id == Msg.UI.SET_LIFE_NODES then
		on_set_life_count(self, message)
	elseif message_id == Msg.UI.LIFE_CHANGED then
		on_player_life_changed(self, message)
	elseif message_id == Msg.UI.SHOW_WIPE then
		on_show_wipe(self, message)
	elseif message_id == Msg.UI.ENABLE_BUTTON_ACTION then
		on_toggle_button_action(self, true)
	elseif message_id == Msg.UI.DISABLE_BUTTON_ACTION then
		on_toggle_button_action(self, false)
	elseif message_id == Msg.UI.ENABLE_MOVE then
		on_toggle_move(self, true)
	elseif message_id == Msg.UI.DISABLE_MOVE then
		on_toggle_move(self, false)
	elseif message_id == Msg.UI.SHOW_SHOP_MODAL then
		on_show_shop_modal(self, message)
	end
end

local MAX_MOVE_CONTROLLER_DISTANCE = 20

local function input_move_zone(self, touched)
	local touch_position = vmath.vector3(touched.x, touched.y, 1)
	local move_pad_node = gui.get_node(Urls.MovePad)
	local move_controller_node = gui.get_node(Urls.MoveController)
	local footer_node = gui.get_node(Urls.Footer)

	if self.move_zone_action.state == ActionStates.Idle and touched.pressed then
		self.move_zone_action.state = ActionStates.Pressed
		self.move_zone_action.touch_id = touched.id
		self.move_zone_action.position = touch_position

		local position = touch_position - gui.get_position(footer_node)

		gui.set_position(move_pad_node, position)
		gui.set_position(move_controller_node, position)
		return
	end

	if self.move_zone_action.state == ActionStates.Pressed and touched.released then
		self.move_zone_action.state = ActionStates.Idle
		self.move_zone_action.touch_id = nil
		self.move_zone_action.position = vmath.vector3(0)

		gui.set_position(move_pad_node, self.original_move_pad_position)
		gui.set_position(move_controller_node, self.original_move_controller_position)

		msg.post(Urls.PlayerController, Msg.Player.MOVE_RELEASED)
		return
	end

	if self.move_zone_action.state == ActionStates.Pressed then
		local delta = touch_position - self.move_zone_action.position
		local distance = vmath.length(delta)
		local direction = distance > 0 and vmath.normalize(delta) or vmath.vector3(0)

		if distance > MAX_MOVE_CONTROLLER_DISTANCE then
			delta = direction * MAX_MOVE_CONTROLLER_DISTANCE
		end

		local move_pad_position = gui.get_position(move_pad_node)
		gui.set_position(move_controller_node, move_pad_position + delta)

		msg.post(Urls.PlayerController, Msg.Player.MOVE_PRESSED, {
			direction = direction,
			force = distance,
		})
	end
end

local MAX_BUTTON_ACTION_DISTANCE = 10
local function input_button(self, touched)
	local button_node = gui.get_node(Urls.Button)

	local touch_position = vmath.vector3(touched.x, touched.y, 1)

	if self.button_action.state == ActionStates.Idle and touched.pressed then
		self.button_action.state = ActionStates.Pressed
		self.button_action.touch_id = touched.id
		self.button_action.position = touch_position
		self.button_action.time = 0

		msg.post(Urls.PlayerController, Msg.Player.PRESSED_SUPER_ACTION)
		return true
	end

	if self.button_action.state == ActionStates.Pressed and touched.released then
		self.button_action.state = ActionStates.Idle
		self.button_action.touch_id = nil
		self.button_action.position = vmath.vector3(0)
		self.button_action.time = 0

		gui.set_position(button_node, self.button_action.original_position)

		msg.post(Urls.PlayerController, Msg.Player.RELEASED_SUPER_ACTION)
		return true
	end

	if self.button_action.state == ActionStates.Pressed then
		local delta = touch_position - self.button_action.position
		local distance = vmath.length(delta)
		local direction = distance > 0 and vmath.normalize(delta) or vmath.vector3(0)

		if distance > MAX_BUTTON_ACTION_DISTANCE then
			delta = direction * MAX_BUTTON_ACTION_DISTANCE
		end

		gui.set_position(button_node, self.button_action.original_position + delta)

		msg.post(Urls.PlayerController, Msg.Player.MOVED_SUPER_ACTION, {
			direction = direction,
			force = distance,
			time = self.button_action.time,
		})

		return true
	end

	return false
end

local function input_keyboards(self, action_id, action)
	if not action_id then
		return false
	end

	local is_up = action_id == Inputs.Up
	local is_down = action_id == Inputs.Down
	local is_left = action_id == Inputs.Left
	local is_right = action_id == Inputs.Right

	if not (is_up or is_down or is_left or is_right) then
		return false
	end

	local x_direction = is_left and -1 or is_right and 1 or 0
	local y_direction = is_up and 1 or is_down and -1 or 0

	if action.pressed then
		self.debug.keyboard_direction = self.debug.keyboard_direction + vmath.vector3(x_direction, y_direction, 0)
	elseif action.released then
		self.debug.keyboard_direction = self.debug.keyboard_direction - vmath.vector3(x_direction, y_direction, 0)
	end

	if vmath.length(self.debug.keyboard_direction) == 0 then
		msg.post(Urls.PlayerController, Msg.Player.MOVE_RELEASED)
		return true
	end

	msg.post(Urls.PlayerController, Msg.Player.MOVE_PRESSED, {
		direction = vmath.normalize(self.debug.keyboard_direction),
		force = 1,
	})

	return true
end

local function input_action(self, action_id, action)
	return false
end

function on_input(self, action_id, action)
	local handled = false
	if action_id == ActionIds.TouchMulti or action_id == ActionIds.Touch then
		local move_zone_node = gui.get_node(Urls.MoveZone)
		local button_node = gui.get_node(Urls.Button)

		if self.upgrade_options_active then
			for _, option in ipairs(SuperActionOptions) do
				local node = gui.get_node(option.node)
				local touched = UtilsGUI.get_touched_by_node(node, action)
				if touched and touched.pressed then
					upgrade_chosen(self, option)
					handled = true
					break
				end
			end
			return handled
		end

		if self.move_zone_action.enabled then
			local touched = UtilsGUI.get_touched_by_node(move_zone_node, action)
			if touched then
				input_move_zone(self, touched)
				handled = true
			end
		end

		if self.button_action.enabled then
			local touched = UtilsGUI.get_touched_by_node(button_node, action)
			if touched then
				input_button(self, touched)
				handled = true
			end
		end
	end

	if self.debug.enabled then
		if input_keyboards(self, action_id, action) then
			handled = true
		end

		if input_action(self, action_id, action) then
			handled = true
		end
	end

	return handled
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
