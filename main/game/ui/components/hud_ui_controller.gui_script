local ManualTimer = require("utils.manual_timer")
local UtilsGUI = require("utils.utils_gui")
local Msg = require("lib.msg")
local ToastGUI = require("lib.toast_gui")
local Colors = require("lib.colors")
local ProgressGUI = require("lib.progress_gui")

local ActionIds = {
	TouchMulti = hash("touch_multi"),
	Touch = hash("touch"),
}

local Urls = {
	GameController = "/controller",
	MainController = "main:/main_controller",
	ControlsUI = "/ui#controls_ui",
	LifeBar = "life_bar",
	LifeProgress = "life_progress",
	EnergyBar = "energy_bar",
	EnergyProgress = "energy_progress",
	Wipe = "wipe",
	ShopModal = "shop_modal",
	CompletedLevelModal = "completed_level_modal/modal",
	CompletedContinueButton = "completed_level_modal/continue_button",
	CompletedContinueButtonText = "completed_level_modal/continue_button_text",
	CompletedRetryButton = "completed_level_modal/retry_button",
	CompletedRetryButtonText = "completed_level_modal/retry_button_text",
	CompletedTimeValue = "completed_level_modal/time_item/value",
	CompletedBestValue = "completed_level_modal/best_item/value",
	UpgradeContainer = "upgrade_container",
	Toast = "toast/frame",
	ToastText = "toast/text",
	ToastIcon = "toast/icon",
	BulletCount = "bullet_count",
}

local UpgradeButtons = {
	{ id = "upgrade_a" },
	{ id = "upgrade_b" },
	{ id = "upgrade_c" },
}

local function get_template_node(instance_id, node_id)
	return gui.get_node(instance_id .. "/" .. node_id)
end

local function get_reward_stat_text(reward_option)
	local stat = reward_option and reward_option.stat_1
	if not stat then
		return ""
	end

	return string.format("%s +%s", stat.name, tostring(stat.value))
end

local function set_upgrade_button_content(node, reward_option)
	local title = reward_option and reward_option.title or ""
	local description = reward_option and reward_option.description or ""
	local stat_text = get_reward_stat_text(reward_option)

	gui.set_text(get_template_node(node, "title"), title)
	gui.set_text(get_template_node(node, "description"), description)
	gui.set_text(get_template_node(node, "text"), stat_text)
	gui.set_enabled(get_template_node(node, "tag_1"), stat_text ~= "")
end

local SHOP_FADE_DURATION = 0.2
local function hide_shop_modal(self)
	local shop_modal_node = gui.get_node(Urls.ShopModal)
	local upgrade_container_node = gui.get_node(Urls.UpgradeContainer)

	gui.cancel_animations(shop_modal_node, "color.w")
	gui.animate(shop_modal_node, "color.w", 0, gui.EASING_OUTEXPO, SHOP_FADE_DURATION, 0, function()
		gui.set_enabled(shop_modal_node, false)
		gui.set_visible(upgrade_container_node, false)
	end)

	for _, upgrade_button in ipairs(UpgradeButtons) do
		local upgrade_button_node = get_template_node(upgrade_button.id, "button")
		gui.cancel_animations(upgrade_button_node, "color.w")
		gui.animate(upgrade_button_node, "color.w", 0, gui.EASING_OUTEXPO, SHOP_FADE_DURATION, 0, function()
			gui.is_enabled(upgrade_button_node, false)
		end)
	end

	self.reward_options = {}
end

local BOOST_DROP = 24
local ANIMATION_TIME = 0.25
local DELAY_BETWEEN_BUTTONS_TIME = 0.15
local function set_reward_options(self)
	for i, upgrade_button in ipairs(UpgradeButtons) do
		local reward_option = self.reward_options[i]
		local upgrade_button_node = get_template_node(upgrade_button.id, "button")
		gui.set_enabled(upgrade_button_node, reward_option ~= nil)
		if reward_option then
			set_upgrade_button_content(upgrade_button.id, reward_option)

			local position = gui.get_position(upgrade_button_node)
			gui.set(upgrade_button_node, "position.y", position.y + BOOST_DROP)
			gui.set(upgrade_button_node, "color.w", 0)

			gui.animate(upgrade_button_node, "color.w", 1, gui.EASING_OUTEXPO, ANIMATION_TIME,
				(i - 1) * DELAY_BETWEEN_BUTTONS_TIME)
			gui.animate(upgrade_button_node, "position.y", position.y, gui.EASING_OUTEXPO, ANIMATION_TIME,
				(i - 1) * DELAY_BETWEEN_BUTTONS_TIME)
		end
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.reward_options = {}
	self.completed_continue_pressed = false
	self.completed_retry_pressed = false
	self.wipe_transition = nil
	self.toast = ToastGUI:new({
		frame_node_id = Urls.Toast,
		text_node_id = Urls.ToastText,
		icon_node_id = Urls.ToastIcon,
	})

	self.life_progress = ProgressGUI:new({
		bar_id = Urls.LifeBar,
		progress_id = Urls.LifeProgress,
		color_bar = Colors["#ffe478"],
		color_bg = Colors["#ffffeb"],
		color_division = Colors["#b27666"],
		length = 3,
		show = true,
	})
	self.energy_progress = ProgressGUI:new({
		bar_id = Urls.EnergyBar,
		progress_id = Urls.EnergyProgress,
		color_bar = Colors["#4da6ff"],
		color_bg = Colors["#ebffeb"],
		color_division = Colors["#473b78"],
		length = 2,
		show = false
	})

	gui.set_enabled(gui.get_node(Urls.CompletedLevelModal), false)
end

local function on_set_bullet_count(self, message)
	local ammo = message.ammo or 0
	gui.set_text(gui.get_node(Urls.BulletCount), string.format("x%02d", ammo))
end

local function wipe_view_pipe(self, dt)
	if not self.wipe_transition then return end

	local transition = self.wipe_transition
	local wipe_node = gui.get_node(Urls.Wipe)
	transition.timer:update(dt)

	local duration = transition.timer.interval
	local progress = duration > 0 and math.min(transition.timer.elapsed / duration, 1) or 1
	local wipe_progress = transition.from + (transition.to - transition.from) * progress

	gui.set(wipe_node, "progress.x", wipe_progress)

	if transition.timer:is_done() then
		if transition.hide_on_complete then
			gui.set_visible(wipe_node, false)
		end

		if transition.complete_message_id then
			msg.post(Urls.GameController, transition.complete_message_id)
		end

		self.wipe_transition = nil
	end
end

function update(self, dt)
	self.life_progress:update(dt)
	self.energy_progress:update(dt)
	wipe_view_pipe(self, dt)
end

local function on_set_max_life_progress(self, message)
	local total_lives = message.total_lives or self.life_progress.length
	self.life_progress:set_length(total_lives)
	self.life_progress:set_value(message.current_lives or total_lives, { instant = true })
end

local function on_life_progress_changed(self, message)
	if message.total_lives then
		self.life_progress:set_length(message.total_lives)
	end
	self.life_progress:set_value(message.current_lives)
end

local function on_enable_special_action(self, message)
	message = message or {}
	if message.length then
		self.energy_progress:set_length(message.length)
	end

	self.energy_progress:set_value(message.value or 0, { instant = true })
	self.energy_progress:show()
end

local function on_disable_special_action(self, _message)
	self.energy_progress:set_value(0, { instant = true })
	self.energy_progress:hide()
end

local function on_set_max_recharge_progress(self, message)
	message = message or {}
	local total_recharge = message.total_recharge or self.energy_progress.length
	self.energy_progress:set_length(total_recharge)
	self.energy_progress:set_value(message.current_recharge or total_recharge, { instant = true })
end

local function on_recharge_progress_changed(self, message)
	message = message or {}
	if message.total_recharge then
		self.energy_progress:set_length(message.total_recharge)
	end
	self.energy_progress:set_value(message.current_recharge or 0)
end

local function start_wipe_transition(self, options)
	local wipe_node = gui.get_node(Urls.Wipe)
	local timer = ManualTimer:new({
		interval = options.duration or 0.5,
	})

	gui.set_visible(wipe_node, true)
	gui.set(wipe_node, "progress.x", options.from)
	timer:start()

	self.wipe_transition = {
		timer = timer,
		from = options.from,
		to = options.to,
		hide_on_complete = options.hide_on_complete or false,
		complete_message_id = options.complete_message_id,
	}
end

local function on_show_wipe(self, message)
	start_wipe_transition(self, {
		from = 0.1,
		to = 1.0,
		duration = message.duration or 0.5,
		complete_message_id = Msg.HudUI.WIPE_SHOWN,
	})
end

local function on_hide_wipe(self, message)
	start_wipe_transition(self, {
		from = 0.9,
		to = 0.0,
		duration = message.duration or 0.5,
		hide_on_complete = true,
		complete_message_id = Msg.HudUI.WIPE_HIDDEN,
	})
end

local SHOP_MODAL_ALPHA = 0.75
local function on_show_shop_modal(self, message)
	local shop_modal_node = gui.get_node(Urls.ShopModal)
	local upgrade_container_node = gui.get_node(Urls.UpgradeContainer)

	self.reward_options = message.options or {}
	gui.set_enabled(shop_modal_node, true)
	gui.set_visible(upgrade_container_node, #self.reward_options > 0)
	gui.set(shop_modal_node, "color.w", 0)
	gui.animate(shop_modal_node, "color.w", SHOP_MODAL_ALPHA, gui.EASING_OUTEXPO, SHOP_FADE_DURATION)

	set_reward_options(self)
end

local function on_show_toast(self, message)
	self.toast:show(message)
end

local function on_hide_toast(self, message)
	self.toast:hide(message.toast_id)
end

local function on_show_completed_level_modal(self, message)
	message = message or {}
	gui.set_text(gui.get_node(Urls.CompletedTimeValue), message.time or "--:--")
	gui.set_text(gui.get_node(Urls.CompletedBestValue), message.best_time or "--:--")
	gui.set_enabled(gui.get_node(Urls.CompletedLevelModal), true)
	msg.post(Urls.ControlsUI, Msg.ControlsUI.BLOCK_CONTROLS)
end

local function on_hide_completed_level_modal(self, _message)
	gui.set_enabled(gui.get_node(Urls.CompletedLevelModal), false)
	self.completed_continue_pressed = false
	self.completed_retry_pressed = false
end

function on_message(self, message_id, message, sender)
	if message_id == Msg.HudUI.SET_MAX_LIFE_PROGRESS then
		on_set_max_life_progress(self, message)
	elseif message_id == Msg.HudUI.CHANGE_LIFE_PROGRESS then
		on_life_progress_changed(self, message)
	elseif message_id == Msg.HudUI.ENABLE_SPECIAL_ACTION then
		on_enable_special_action(self, message)
	elseif message_id == Msg.HudUI.DISABLE_SPECIAL_ACTION then
		on_disable_special_action(self, message)
	elseif message_id == Msg.HudUI.SET_MAX_RECHARGE_PROGRESS then
		on_set_max_recharge_progress(self, message)
	elseif message_id == Msg.HudUI.CHANGE_RECHARGE_PROGRESS then
		on_recharge_progress_changed(self, message)
	elseif message_id == Msg.HudUI.SET_BULLET_COUNT then
		on_set_bullet_count(self, message)
	elseif message_id == Msg.HudUI.SHOW_WIPE then
		on_show_wipe(self, message)
	elseif message_id == Msg.HudUI.HIDE_WIPE then
		on_hide_wipe(self, message)
	elseif message_id == Msg.HudUI.SHOW_SHOP_MODAL then
		on_show_shop_modal(self, message)
	elseif message_id == Msg.HudUI.SHOW_TOAST then
		on_show_toast(self, message)
	elseif message_id == Msg.HudUI.HIDE_TOAST then
		on_hide_toast(self, message)
	elseif message_id == Msg.HudUI.SHOW_COMPLETED_LEVEL_MODAL then
		on_show_completed_level_modal(self, message)
	elseif message_id == Msg.HudUI.HIDE_COMPLETED_LEVEL_MODAL then
		on_hide_completed_level_modal(self, message)
	end
end

local function press_button(button, label)
	gui.play_flipbook(button, "pressed", nil)
	gui.animate(label, "position.y", -2, gui.EASING_LINEAR, 0.1, 0)
end

local function release_button(button, label)
	gui.play_flipbook(button, "unpressed")
	gui.animate(label, "position.y", 1, gui.EASING_LINEAR, 0.1, 0)
end

local function input_button(options, action)
	local button = gui.get_node(options.button)
	local label = gui.get_node(options.label)

	if action.pressed and gui.pick_node(button, action.x, action.y) then
		press_button(button, label)
		options.set_pressed(true)
		return true
	end

	if options.get_pressed() and not action.released and not gui.pick_node(button, action.x, action.y) then
		release_button(button, label)
		options.set_pressed(false)
		return false
	end

	if action.released and options.get_pressed() then
		release_button(button, label)
		options.set_pressed(false)

		if options.on_pressed then
			options.on_pressed()
		end
		return true
	end

	return false
end

local function input_completed_level_modal(self, action)
	local modal_node = gui.get_node(Urls.CompletedLevelModal)
	if not gui.is_enabled(modal_node) then
		return false
	end

	if input_button({
				button = Urls.CompletedContinueButton,
				label = Urls.CompletedContinueButtonText,
				get_pressed = function()
					return self.completed_continue_pressed
				end,
				set_pressed = function(value)
					self.completed_continue_pressed = value
				end,
				on_pressed = function()
					msg.post(Urls.MainController, Msg.Main.GAME_OVER)
				end,
			}, action) then
		return true
	end

	if input_button({
				button = Urls.CompletedRetryButton,
				label = Urls.CompletedRetryButtonText,
				get_pressed = function()
					return self.completed_retry_pressed
				end,
				set_pressed = function(value)
					self.completed_retry_pressed = value
				end,
				on_pressed = function()
					msg.post(Urls.MainController, Msg.Main.START_NEW_GAME)
				end,
			}, action) then
		return true
	end

	return true
end

local function input_shop_modal(self, action)
	local shop_modal_node = gui.get_node(Urls.ShopModal)
	if not gui.is_enabled(shop_modal_node) then
		return false
	end

	for index, upgrade_button in ipairs(UpgradeButtons) do
		local reward_option = self.reward_options[index]
		if reward_option then
			local button_node = get_template_node(upgrade_button.id, "button")
			local touched = UtilsGUI.get_touched_by_node(button_node, action)
			if touched and touched.pressed then
				msg.post(Urls.GameController, Msg.Game.PROCESS_PLAYER_UPGRADE, {
					selected = reward_option,
				})
				hide_shop_modal(self)
				return true
			end
		end
	end

	return true
end

function on_input(self, action_id, action)
	if action_id == ActionIds.TouchMulti or action_id == ActionIds.Touch then
		if input_completed_level_modal(self, action) then
			return true
		end

		return input_shop_modal(self, action)
	end

	return false
end
