name: "star_flare"
tags: "tile"
vertex_program: "/main/materials/star_flare/star_flare.vp"
fragment_program: "/main/materials/star_flare/star_flare.fp"
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
fragment_constants {
  name: "tint"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    z: 1.0
    w: 1.0
  }
}
fragment_constants {
  name: "radial_params"
  type: CONSTANT_TYPE_USER
  value {
    y: 0.5
    w: 1.0
  }
}
fragment_constants {
  name: "rotation_params"
  type: CONSTANT_TYPE_USER
  value {
  }
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_NEAREST
  filter_mag: FILTER_MODE_MAG_NEAREST
}
attributes {
  name: "position_local"
  semantic_type: SEMANTIC_TYPE_POSITION
}
attributes {
  name: "sprite_size"
  double_values {
    v: 0.0
    v: 0.0
  }
  vector_type: VECTOR_TYPE_VEC2
}
attributes {
  name: "mtx_texture_transform_2d"
  semantic_type: SEMANTIC_TYPE_TEXTURE_TRANSFORM_2D
  vector_type: VECTOR_TYPE_MAT3
}
