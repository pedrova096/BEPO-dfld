name: "progress_gui"
tags: "gui"
vertex_program: "/main/materials/progress_gui/progress_gui.vp"
fragment_program: "/main/materials/progress_gui/progress_gui.fp"
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
fragment_constants {
  name: "color_bar"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    w: 1.0
  }
}
fragment_constants {
  name: "color_bg"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    w: 1.0
  }
}
fragment_constants {
  name: "color_division"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    z: 1.0
    w: 1.0
  }
}
fragment_constants {
  name: "params"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
  }
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_DEFAULT
  filter_mag: FILTER_MODE_MAG_DEFAULT
}
