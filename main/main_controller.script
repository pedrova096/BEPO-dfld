local Msg = require("lib.msg")

local GameState = {
	None = 0,
	StartScreen = 1,
	Loading = 2,
	InGame = 3,
	GameOver = 4,
}

local Urls = {
	StartScreenProxy = "/proxies#start_screen_proxy",
	GameProxy = "/proxies#game_proxy",
	GameOverProxy = "/proxies#game_over_proxy",
	GameController = "game:/controller",
}

local DEFAULT_LEVEL_ID = hash("level_1")

function init(self)
	self.state = GameState.None
	msg.post(Urls.StartScreenProxy, "load")
end

function final(self)
end

function update(self, dt)
end

function fixed_update(self, dt)
end

local function on_game_over(self, message)
	msg.post(Urls.GameProxy, "disable")
	msg.post(Urls.GameProxy, "final")
	msg.post(Urls.GameProxy, "unload")

	msg.post(Urls.GameOverProxy, "load")
end

local PROXY_FRAGMENT_MAP = {
	[hash("start_screen")] = Urls.StartScreenProxy,
	[hash("game_over")] = Urls.GameOverProxy,
}
local function on_new_game(self, message, sender_socket)
	local proxy = PROXY_FRAGMENT_MAP[sender_socket]

	if not proxy then return end
	msg.post(proxy, "disable")
	msg.post(proxy, "final")
	msg.post(proxy, "unload")

	msg.post(Urls.GameProxy, "load")

	self.selected_level = message.level_id or DEFAULT_LEVEL_ID
end

function on_message(self, message_id, message, sender)
	if message_id == Msg.PROXY_LOADED then
		pprint("PROXY_LOADED", sender, message)
		msg.post(sender, "enable")
		msg.post(sender, "acquire_input_focus")
		if sender == msg.url(Urls.StartScreenProxy) then
			self.state = GameState.StartScreen
		end

		if sender == msg.url(Urls.GameProxy) then
			msg.post(Urls.GameController, Msg.Game.START_RUN, { level_id = self.selected_level })
			-- msg.post(sender, "set_time_step", { factor = 0.25, mode = 0 })
			self.state = GameState.InGame
		end

		if sender == msg.url(Urls.GameOverProxy) then
			self.state = GameState.GameOver
		end
	elseif message_id == Msg.Main.GAME_OVER then
		on_game_over(self, message)
	elseif message_id == Msg.Main.START_NEW_GAME then
		on_new_game(self, message, sender.socket)
	end


	if message_id == Msg.PROXY_UNLOADED then
	end
end

function on_input(self, action_id, action)
end

function on_reload(self)
end
